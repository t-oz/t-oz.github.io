# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Keep local development files private, except the CV source and rebuild files.
local/*
!local/cv/
local/cv/*
!local/cv/tyler-osborne-cv.tex
!local/cv/template-original.tex
!local/cv/LICENSE-template
!local/cv/README.md
!local/cv/expected-text.txt
!local/cv/verify.py

# Ignore the Gemfile that is generated
Gemfile.lock

# Ignore files created by npm
node_modules
package-lock.json

# Ignore the vendor file and bundle for alternative installation
vendor/
.bundle/

.DS_Store
